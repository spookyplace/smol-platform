# Versions for Smol. Single source of truth for README prerequisites and `make doctor`.
# Last checked: 2026-11-25, against GitHub releases, Docker Hub and nodejs.org.
# Keep comments on their own lines: Make keeps the whitespace before an inline `#` as part of the value.
#
# Two kinds of entry:
# - Exact pins: what runs in or defines the platform. Policy: the newest minor whose .0 has been out >= 14 days,
#   at its newest patch (patches carry fixes, so they aren't held back).
# - Client tools: a compatibility rule that `make doctor` checks, not an exact version.

# === Exact pins (platform) ===
# n-1 Kubernetes minor; ArgoCD 3.6 supports 1.34-1.37
K3S_IMAGE=rancher/k3s:v1.36.6-k3s1
FLOCI_IMAGE=floci/floci:2.4.0
# ArgoCD server; CLI must match its minor
ARGOCD_VERSION=3.6.3
# argo/argo-cd Helm chart whose appVersion is ARGOCD_VERSION; also in gitops/apps/argocd.yaml (`make argocd` checks both)
ARGOCD_CHART_VERSION=10.19.1
# Phase 3, re-check before use; CLI must match its minor
CROSSPLANE_VERSION=2.4.4

# === Client tools (rules) ===
# Docker Engine: at least this version
DOCKER_MIN_VERSION=29.0
# k3d: this major
K3D_MAJOR=5
# kubectl: within this many minors of the K3S_IMAGE minor (Kubernetes version-skew policy)
KUBECTL_MAX_SKEW=1
# Helm: this major
HELM_MAJOR=4
# ArgoCD CLI and Crossplane CLI: same minor as the pinned server (derived from the pins above)
# gh: at least this version
GH_MIN_VERSION=2.104
# Node.js: this major (Backstage recommends 24 or 26; 26 is the active LTS)
NODE_MAJOR=26
# AWS CLI (Phase 3): this major
AWSCLI_MAJOR=2
