# Copy to local.env (gitignored) and fill in. Read by `make backstage-secrets`.
# Values here are not secret; the two *_FILE entries point at secret files kept outside any repo (mode 600).
# Use absolute paths: `~` is not expanded.

# GitHub App for Backstage (ADR-0003), from the App's settings page
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_CLIENT_SECRET_FILE=
